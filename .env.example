# REWIND configuration. Copy to .env and adjust. Never commit real secrets.
# Bind address. Keep loopback for local use; any other value requires REWIND_ALLOWED_HOSTS.
REWIND_HOST=127.0.0.1
REWIND_PORT=4747
# SQLite database file (created and migrated on start).
REWIND_DB_PATH=./data/rewind.db
# Label recorded on every execution.
REWIND_ENVIRONMENT=local-demo
# Hostnames accepted in Host/Origin headers when binding beyond loopback (comma-separated).
# REWIND_ALLOWED_HOSTS=rewind.example.com
# Secure session cookies: auto (when served over HTTPS), true or false.
REWIND_COOKIE_SECURE=auto
# agentcore: accept MCP calls already authenticated by Amazon Bedrock AgentCore Runtime. Never on a public server.
REWIND_TRUST_UPSTREAM_AUTH=none
REWIND_RETENTION_DAYS=30
REWIND_GUEST_RETENTION_HOURS=48
REWIND_LOG_LEVEL=info
REWIND_DEMO_TIMEOUT_MS=1500
# Base URL used in invitation and password-reset links (defaults to http://REWIND_HOST:REWIND_PORT).
# REWIND_PUBLIC_URL=https://rewind.example.com
# Bearer token required for /metrics when not bound to loopback (16+ chars). Placeholder only:
# REWIND_METRICS_TOKEN=replace-with-a-long-random-value
# Allow http:// and private-address webhook targets. Defaults to true on loopback, false otherwise.
# REWIND_ALLOW_PRIVATE_WEBHOOKS=false
